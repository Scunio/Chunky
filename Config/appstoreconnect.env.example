# Copia questo file in Config/appstoreconnect.env (senza .example) e riempi i tre valori.
# Quel file è gitignorato: resta solo su questa macchina.
#
# Dove trovarli: App Store Connect > Users and Access > Integrations > App Store Connect API.
# "Generate API Key" con ruolo almeno "App Manager". Il file .p8 si scarica UNA SOLA VOLTA
# alla creazione: spostalo subito in un posto stabile, Apple non lo ridà.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/percorso/assoluto/AuthKey_XXXXXXXXXX.p8
